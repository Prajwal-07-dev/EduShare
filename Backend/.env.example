# Copy this file to ".env" and fill it in. Never commit ".env".

PORT=3000

# Long random string used to sign login tokens (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts
JWT_EXPIRES_IN=7d

# Only needed if your frontend is hosted on a different domain than this server.
# Comma separated, e.g. https://edushare.example.com
CORS_ORIGINS=

# Where the SQLite database and uploaded files are stored (relative to Backend/)
# DATA_DIR=data

# Where the frontend files live (relative to Backend/)
# FRONTEND_DIR=../Frontend

# Set to 1 when running behind a proxy such as nginx, Render or Railway
# TRUST_PROXY=1
